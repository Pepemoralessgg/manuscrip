ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: see https://docs.anthropic.com/en/docs/about-claude/models/overview
# ANTHROPIC_MODEL=claude-sonnet-4-6
# Modo por defecto del endpoint analyze-manuscrip: eco (1 llamada) | full (muchas llamadas)
# MANUSCRIP_MODE=eco
# Para ahorrar aún más: modelo más barato en modo eco, p. ej. Haiku (consulta IDs en la documentación)
PORT=3000

# --- Supabase (puedes usar .env.local con los mismos nombres) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# UUID de un usuario real (auth.users) para la UI sin JWT todavía:
# SUPABASE_DEFAULT_USER_ID=
# Si manuscripts.content es jsonb en Supabase, puedes poner 1 para enviar objeto en vez de string:
# MANUSCRIP_CONTENT_JSONB=1

# --- Cola / email (pasos siguientes) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RESEND_API_KEY=
# BullMQ necesita conexión Redis por URL (rediss://). Si solo tienes REST de Upstash, pide en el panel la "Redis URL" TLS.
